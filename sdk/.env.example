# VaultBounty SDK — Environment Variables
# Copy to .env and fill in your values

# Researcher wallet (submits reports + writes CDR vault)
RESEARCHER_PRIVATE_KEY=

# Company wallet (pays bounties)
COMPANY_PRIVATE_KEY=

# TEE operator wallet (signs attestations + registered in MockTEEVerifier)
TEE_RELAYER_PRIVATE_KEY=

# DAO multisig address (receives 15% of bounty + governs TEE operator set)
DAO_ADDRESS=

# Story Aeneid testnet
RPC_URL=https://aeneid.storyrpc.io
API_URL=http://172.192.41.96:1317

# TEE verification service
TEE_SERVICE_URL=http://localhost:3001
# Set to false to use EOA fallback attestation (no TEE service needed)
USE_TEE_SERVICE=true

# Deployed contract addresses (fill after running deploy script)
BOUNTY_REGISTRY_ADDRESS=
BOUNTY_READ_CONDITION_ADDRESS=
RESEARCHER_WRITE_CONDITION_ADDRESS=
MOCK_TEE_VERIFIER_ADDRESS=
VULNERABLE_VAULT_ADDRESS=

# Story Protocol — set after registering IP Asset
IP_ID=
LICENSE_TERMS_ID=

# Demo mode (true = 2min escalation window)
DEMO_MODE=true
